{
  "name": "grass-shift-handover",
  "version": "1.7.11",
  "description": "GRASS — Передача смены — площадки Ахтуба и Волжский: смены, передача, сводка, исполнители, вложения",
  "main": "main.js",
  "author": "GRASS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/shifts.test.js tests/stats.test.js tests/reglament.test.js tests/journal.test.js tests/comments.test.js tests/export.test.js"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.grass.shift-handover",
    "productName": "GRASS — Передача смены",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "shifts.js",
      "stats.js",
      "reglament.js",
      "ui-reglament.js",
      "journal.js",
      "ui-journal.js",
      "comments.js",
      "ui-schedule.js",
      "ui-notify.js",
      "export.js",
      "ui-export.js",
      "ui-subtasks.js",
      "ui-watch.js",
      "ui-announce.js",
      "ui-whatsnew.js",
      "styles.css",
      "package.json",
      "GRASS_icon.ico",
      "img/**/*",
      "fonts/**/*",
      "shift-summary-icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GRASS-Peredacha-smeny-Setup-${version}.${ext}",
      "icon": "GRASS_icon.ico",
      "executableName": "GRASS-Peredacha-smeny"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GRASS — Передача смены",
      "runAfterFinish": true,
      "uninstallDisplayName": "GRASS — Передача смены",
      "deleteAppDataOnUninstall": false
    },
    "icon": "GRASS_icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "nosikovalex300",
        "repo": "GRASS-Peredacha-smeny",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
